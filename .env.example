# Copy to .env and change every value. .env is gitignored.
DB_USERNAME=roombooking
DB_PASSWORD=change-me
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
# Expose Swagger UI at /swagger-ui.html (off by default in prod)
API_DOCS_ENABLED=true
# Host port for the API (8080 is often taken)
APP_PORT=8081